# Copy to .env and edit. Everything here has a working default except
# SECRET_KEY, which you must change before going anywhere near production.

ENVIRONMENT=development
DEBUG=true
SITE_URL=http://localhost:5173
OWNER_NAME=Christopher James
OWNER_EMAIL=hello@chrisjames.dev

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-in-production-please-use-a-64-char-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# SQLite for development; PostgreSQL for production:
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/portfolio
DATABASE_URL=sqlite+aiosqlite:///./portfolio.db
DB_ECHO=false

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# With EMAIL_DRY_RUN=true, mail is logged to the email_logs table instead of
# being sent. Handy in development, and the whole notification flow still runs.
EMAIL_DRY_RUN=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=true
EMAIL_FROM=Christopher James <no-reply@chrisjames.dev>

MAX_UPLOAD_MB=64
MEDIA_URL=/media

# Moderation defaults. All three are overridable at runtime from the
# dashboard, which writes to the site_settings table.
AUTO_PUBLISH_SUBMISSIONS=false
AUTO_APPROVE_COMMENTS=true
COMMENTS_REQUIRE_LOGIN=false

# mock | stripe | paystack | flutterwave
PAYMENT_PROVIDER=mock
DEFAULT_CURRENCY=USD
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_SECRET=

# The first account, created on first boot. Change the password immediately.
FIRST_SUPERUSER_EMAIL=admin@chrisjames.dev
FIRST_SUPERUSER_PASSWORD=ChangeMe123!
FIRST_SUPERUSER_USERNAME=chrisjames

RATE_LIMIT_ENABLED=true
RATE_LIMIT_ANON_PER_MINUTE=90
RATE_LIMIT_AUTH_PER_MINUTE=300
