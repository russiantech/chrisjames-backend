# Copy to .env (local) or set these in your Vercel project settings
# (production). Values below are illustrative — replace with real ones.
#
# Two confidence levels here, marked explicitly:
#   [confirmed]  — I've seen this exact name referenced in code you've shared
#   [assumed]    — a typical FastAPI setup would have this; verify the name
#                  actually matches your Settings class before relying on it

# --------------------------------------------------------------- database
# [assumed] — every route we've touched goes through DbSession, but I
# haven't seen your engine/session setup itself.
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/chrisjames

# ------------------------------------------------------------------- auth
# [assumed] — referenced indirectly (JWTs with scopes are already live per
# your logs), but I haven't seen the actual settings names.
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# ------------------------------------------------------------------- cors
# [assumed] — must include the frontend's real origin(s) or every browser
# request fails with a CORS error even though curl/Postman look fine.
# Comma-separated if your settings parse it that way; adjust to match.
CORS_ORIGINS=http://localhost:5173,https://chrisjames.vercel.app

# ------------------------------------------------------------- site & api
# [confirmed] — SITE_URL is referenced in app/api/posts.py (building the
# "view your approved post" email link) and is also what the mock payment
# provider's checkout_url should be built from, so Advertise.tsx's
# same-origin check resolves correctly against wherever the frontend
# actually is.
SITE_URL=https://chrisjames.vercel.app
# [confirmed] — referenced in app/api/media.py's signed_upload().
API_V1_PREFIX=/api/v1

# --------------------------------------------------------------- storage
# [confirmed] — read directly by app/services/storage.py.
#
# IMPORTANT if this backend runs on Vercel: Vercel's filesystem is
# ephemeral per invocation and wiped on every deploy — "local" storage
# will silently lose every uploaded file. Use "s3" in production (R2,
# Spaces, and B2 all work — anything S3-compatible).
STORAGE_BACKEND=local
MEDIA_ROOT=./media
MEDIA_URL=http://localhost:8000/media
MAX_UPLOAD_MB=25

# Only read when STORAGE_BACKEND=s3:
# S3_BUCKET=chrisjames-media
# S3_REGION=auto
# S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_BASE_URL=https://media.chrisjames.dev

# --------------------------------------------------------------- payments
# [confirmed: the setting exists] payment_provider is exposed on
# PublicSettings and Checkout.tsx branches on it ("mock" vs a real
# provider). [assumed: the names below] — I don't have the payment
# provider/router code, so these are the names a Paystack integration
# would typically need; confirm against whatever you actually have.
PAYMENT_PROVIDER=mock
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
